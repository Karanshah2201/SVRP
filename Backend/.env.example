# ==========================================
# 3D MODEL DIGITAL STORE - ENVIRONMENT CONFIG
# ==========================================

# Server
PORT=5000
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# JWT Secret - Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# MongoDB Connection String (Atlas or Local)
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/railworks?retryWrites=true&w=majority

# Default Admin Credentials (Auto-seeded on first run)
ADMIN_EMAIL=admin@railworks.com
ADMIN_PASSWORD=AdminStrongPassword123!

# ==========================================
# PAYMENT GATEWAY - RAZORPAY
# ==========================================
# Get from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyId
RAZORPAY_KEY_SECRET=YourRazorpayKeySecret
# Webhook secret configured in Razorpay Dashboard -> Webhooks
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecret

# ==========================================
# CLOUD STORAGE: GOOGLE DRIVE (SERVICE ACCOUNT)
# ==========================================
# Create a Service Account in Google Cloud Console, enable Google Drive API v3,
# download the JSON key, and share your private 3D asset Drive folder with the client_email.
GOOGLE_DRIVE_CLIENT_EMAIL=service-account@your-gcp-project.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=your_private_google_drive_folder_id

# ==========================================
# CLOUD STORAGE: MICROSOFT ONEDRIVE / GRAPH API
# ==========================================
# Create an App Registration in Azure Portal, grant Files.ReadWrite.All application permission
MICROSOFT_GRAPH_CLIENT_ID=your_azure_ad_client_id
MICROSOFT_GRAPH_CLIENT_SECRET=your_azure_ad_client_secret
MICROSOFT_GRAPH_TENANT_ID=your_azure_ad_tenant_id_or_common

# ==========================================
# CLOUD STORAGE: CLOUDFLARE R2 (RECOMMENDED - ZERO EGRESS)
# ==========================================
# Create a bucket in Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=railworks-3d-models

# ==========================================
# Gmail SMTP Configuration
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-gmail-app-password
EMAIL_FROM="Your 3D Model Store <your-email@gmail.com>"

# Email Testing
TEST_EMAIL_TO=your-test-email@gmail.com

# ==========================================
# 48-HOUR AUTOMATIC CLOUD ACCESS REVOCATION
# ==========================================
# Default access duration in hours before automatic revocation (default: 48)
ACCESS_GRANT_DURATION_HOURS=48
# Background scheduler check interval in seconds (default: 60)
REVOCATION_CHECK_INTERVAL_SECONDS=60
# Maximum retry attempts for temporary provider API failures before marking failed (default: 5)
REVOCATION_MAX_RETRIES=5

